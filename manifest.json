{
  "manifest_version": 3,
  "name": "Sunway Learning Support",
  "version": "1.0.0",
  "description": "AI-powered eLearn announcement aggregator",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "alarms"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://elearn.sunway.edu.my/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://elearn.sunway.edu.my/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/popup/index.html", "public/icon128.png"],
      "matches": ["https://elearn.sunway.edu.my/*", "<all_urls>"]
    }
  ]
}
