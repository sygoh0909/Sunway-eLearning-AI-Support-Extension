{
  "manifest_version": 3,
  "name": "Sunway Learning Support",
  "version": "1.0.0",
  "description": "AI-powered eLearn announcement aggregator",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "alarms"],
  "host_permissions": ["https://elearn.sunway.edu.my/*"],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://elearn.sunway.edu.my/*"],
      "js": ["src/content/index.ts"]
    }
  ]
}